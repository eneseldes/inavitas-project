# --- Ortak ---
NODE_ENV=development
LOG_LEVEL=debug
COOKIE_SECURE=false

# --- JWT ---
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Postgres: Servis başına ayrı veritabanı + İKİ kullanıcı 
# *_DATABASE_URL     → migrator kullanıcısı, DDL yetkileri
# *_APP_DATABASE_URL → runtime kullanıcısı, DML yetkileri
ACCESS_DATABASE_URL=postgresql://access_migrator:access_migrator_pw@localhost:5432/access_db
ACCESS_APP_DATABASE_URL=postgresql://access_app:access_app_pw@localhost:5432/access_db

OUTAGE_DATABASE_URL=postgresql://outage_migrator:outage_migrator_pw@localhost:5432/outage_db
OUTAGE_APP_DATABASE_URL=postgresql://outage_app:outage_app_pw@localhost:5432/outage_db

WORK_ORDER_DATABASE_URL=postgresql://work_order_migrator:work_order_migrator_pw@localhost:5432/work_order_db
WORK_ORDER_APP_DATABASE_URL=postgresql://work_order_app:work_order_app_pw@localhost:5432/work_order_db

TRANSLATION_DATABASE_URL=postgresql://translation_migrator:translation_migrator_pw@localhost:5432/translation_db
TRANSLATION_APP_DATABASE_URL=postgresql://translation_app:translation_app_pw@localhost:5432/translation_db

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Kafka ---
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=inavitas

# --- Portlar ---
GATEWAY_PORT=8080
ACCESS_SERVICE_PORT=3001
OUTAGE_SERVICE_PORT=3002
WORK_ORDER_SERVICE_PORT=3003
TRANSLATION_SERVICE_PORT=3004

# --- Translation Provider ---
TRANSLATION_PROVIDER=none
DEEPL_API_KEY=

# --- Frontend / nginx ---
CORS_ORIGIN=http://localhost

# --- Log Yığını ---
GRAFANA_ADMIN_PASSWORD=admin
