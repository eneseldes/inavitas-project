{
  "uid": "inavitas-network",
  "title": "Inavitas — Şebeke ve Harita",
  "description": "Tile üretimi, graf sorguları, poligon sorgusu ve enerjilenme. Kabul ölçütlerindeki performans hedefleri bu panodan okunur.",
  "tags": [
    "inavitas",
    "network",
    "map"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tile cache isabet oranı",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(network_tile_cache_total{source=\"hit\"}[5m])) / clamp_min(sum(rate(network_tile_cache_total[5m])), 0.0001)",
          "legendFormat": "isabet oranı",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Hedef %95. Altına düşerse ya cache TTL doldu ya TILE_SCHEMA_VERSION artırıldı (tüm anahtar uzayı tazelenir) ya da kapsam imzaları parçalandı."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tile süresi p95 — isabet / ıska",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 16,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (source, le) (rate(network_tile_render_seconds_bucket{layer=\"network\"}[5m])))",
          "legendFormat": "şebeke {{source}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (source, le) (rate(network_tile_render_seconds_bucket{layer=\"highlight\"}[5m])))",
          "legendFormat": "vurgu {{source}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "description": "Kabul ölçütü: cache-hit < 30 ms, cache-miss < 400 ms (p95). Süre Redis okumasını da kapsar — kullanıcının gördüğü gecikme budur."
    },
