{
  "info": {
    "name": "INAVITAS — Kesinti & İş Emri (Faz 0-3)",
    "description": "Gateway (:8080) tek giriş noktası. Önce 'Auth' klasöründen bir login isteği çalıştır — accessToken/userId/userPermissions collection değişkenlerini otomatik doldurur. Sonraki tüm istekler gateway üzerinden gider ve Authorization: Bearer header'ı otomatik eklenir; gateway JWT'yi merkezi doğrulayıp X-User-* header'larını downstream servislere kendisi ekler.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayUrl", "value": "http://localhost:8080" },
    { "key": "accessDirectUrl", "value": "http://localhost:3001" },
    { "key": "outageDirectUrl", "value": "http://localhost:3002" },
    { "key": "workOrderDirectUrl", "value": "http://localhost:3003" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "userEmail", "value": "" },
    { "key": "userPermissions", "value": "" },
    { "key": "outageId", "value": "" },
    { "key": "outageVersion", "value": "0" },
    { "key": "workOrderId", "value": "" },
    { "key": "workOrderVersion", "value": "0" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth (gateway → access-service)",
      "item": [
        {
          "name": "Login — admin (her iki yetki de var)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "pm.collectionVariables.set('userId', body.user.id);",
                  "pm.collectionVariables.set('userEmail', body.user.email);",
                  "pm.collectionVariables.set('userPermissions', body.user.permissions.join(','));",
                  "pm.test('200 döndü', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@inavitas.com\",\n  \"password\": \"Admin123!\"\n}" },
            "url": { "raw": "{{gatewayUrl}}/api/auth/login", "host": ["{{gatewayUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login — kesinti operatörü (yalnızca outage:*)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "pm.collectionVariables.set('userId', body.user.id);",
                  "pm.collectionVariables.set('userEmail', body.user.email);",
                  "pm.collectionVariables.set('userPermissions', body.user.permissions.join(','));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"kesinti@inavitas.com\",\n  \"password\": \"Kesinti123!\"\n}" },
            "url": { "raw": "{{gatewayUrl}}/api/auth/login", "host": ["{{gatewayUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login — saha personeli (yalnızca workorder:*)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "pm.collectionVariables.set('userId', body.user.id);",
                  "pm.collectionVariables.set('userEmail', body.user.email);",
                  "pm.collectionVariables.set('userPermissions', body.user.permissions.join(','));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"isemri@inavitas.com\",\n  \"password\": \"IsEmri123!\"\n}" },
            "url": { "raw": "{{gatewayUrl}}/api/auth/login", "host": ["{{gatewayUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{gatewayUrl}}/api/auth/me", "host": ["{{gatewayUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{gatewayUrl}}/api/auth/refresh", "host": ["{{gatewayUrl}}"], "path": ["api", "auth", "refresh"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{gatewayUrl}}/api/auth/logout", "host": ["{{gatewayUrl}}"], "path": ["api", "auth", "logout"] }
          }
        },
        {
          "name": "Login — header spoofing denemesi (X-User-Id sızmamalı)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('gateway spoofed X-User-Id\\'yi görmezden gelir', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user.id).to.not.eql('fake-admin-id');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "fake-admin-id" },
              { "key": "X-User-Permissions", "value": "user:manage" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"kesinti@inavitas.com\",\n  \"password\": \"Kesinti123!\"\n}" },
            "url": { "raw": "{{gatewayUrl}}/api/auth/login", "host": ["{{gatewayUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Outages (gateway → outage-service)",
      "item": [
        {
          "name": "Create Outage",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('outageId', body.id);",
                  "  pm.collectionVariables.set('outageVersion', String(body.version));",
                  "}",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"gisId\": \"CB-1024\",\n  \"startedAt\": \"2026-08-06T10:00:00Z\"\n}" },
            "url": { "raw": "{{gatewayUrl}}/api/outages", "host": ["{{gatewayUrl}}"], "path": ["api", "outages"] }
          }
        },
        {
          "name": "Create Outage (endedAt verilirse otomatik ENERGIZED — FR-2.6)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gisId\": \"CB-2048\",\n  \"startedAt\": \"2026-08-06T08:00:00Z\",\n  \"endedAt\": \"2026-08-06T09:30:00Z\"\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/api/outages", "host": ["{{gatewayUrl}}"], "path": ["api", "outages"] }
          }
        },
        {
          "name": "Create Outage — geçersiz (endedAt < startedAt) -> 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gisId\": \"CB-9999\",\n  \"startedAt\": \"2026-08-06T10:00:00Z\",\n  \"endedAt\": \"2026-08-06T09:00:00Z\"\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/api/outages", "host": ["{{gatewayUrl}}"], "path": ["api", "outages"] }
          }
        },
        {
          "name": "List Outages (sayfalama + sıralama)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gatewayUrl}}/api/outages?page=1&pageSize=25&sort=createdAt:desc",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "outages"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "25" },
                { "key": "sort", "value": "createdAt:desc" }
              ]
            }
          }
        },
        {
          "name": "List Outages (filtre: status + gisId + tarih aralığı)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gatewayUrl}}/api/outages?status=STARTED,ENERGIZED&gisId=CB-1024&startedAtFrom=2026-01-01&startedAtTo=2026-12-31",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "outages"],
              "query": [
                { "key": "status", "value": "STARTED,ENERGIZED" },
                { "key": "gisId", "value": "CB-1024" },
                { "key": "startedAtFrom", "value": "2026-01-01" },
                { "key": "startedAtTo", "value": "2026-12-31" }
              ]
            }
          }
        },
        {
          "name": "Get Outage by Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{gatewayUrl}}/api/outages/{{outageId}}", "host": ["{{gatewayUrl}}"], "path": ["api", "outages", "{{outageId}}"] }
          }
        },
        {
          "name": "Patch Outage — STARTED → ENERGIZED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('outageVersion', String(pm.response.json().version));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ENERGIZED\",\n  \"version\": {{outageVersion}}\n}" },
            "url": { "raw": "{{gatewayUrl}}/api/outages/{{outageId}}", "host": ["{{gatewayUrl}}"], "path": ["api", "outages", "{{outageId}}"] }
          }
        },
        {
          "name": "Patch Outage — geçersiz geçiş STARTED → ARCHIVED -> 409",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ARCHIVED\",\n  \"version\": 0\n}" },
            "url": { "raw": "{{gatewayUrl}}/api/outages/{{outageId}}", "host": ["{{gatewayUrl}}"], "path": ["api", "outages", "{{outageId}}"] }
          }
        },
        {
          "name": "Patch Outage — bayat version (aynı isteği tekrarla) -> 409 optimistic lock",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ENERGIZED\",\n  \"version\": 0\n}" },
            "url": { "raw": "{{gatewayUrl}}/api/outages/{{outageId}}", "host": ["{{gatewayUrl}}"], "path": ["api", "outages", "{{outageId}}"] }
          }
        },
        {
          "name": "Create Outage — yetkisiz (saha personeli token'ıyla) -> 403",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"gisId\": \"CB-0001\",\n  \"startedAt\": \"2026-08-06T10:00:00Z\"\n}" },
            "url": { "raw": "{{gatewayUrl}}/api/outages", "host": ["{{gatewayUrl}}"], "path": ["api", "outages"] },
            "description": "Önce 'Login — saha personeli' isteğini çalıştır, sonra bunu — workorder:* izniyle outage yazmaya çalışır."
          }
        },
        {
          "name": "List Outages — token'sız -> 401",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{gatewayUrl}}/api/outages", "host": ["{{gatewayUrl}}"], "path": ["api", "outages"] }
          }
        }
      ]
    },
    {
      "name": "Work Orders (gateway → work-order-service)",
      "item": [
        {
          "name": "Create Work Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('workOrderId', body.id);",
                  "  pm.collectionVariables.set('workOrderVersion', String(body.version));",
                  "}",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"gisId\": \"CB-1024\",\n  \"type\": \"PLANNED_OUTAGE_WORK_ORDER\"\n}" },
            "url": { "raw": "{{gatewayUrl}}/api/work-orders", "host": ["{{gatewayUrl}}"], "path": ["api", "work-orders"] }
          }
        },
        {
          "name": "Create Work Order — geçersiz type -> 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"gisId\": \"CB-1024\",\n  \"type\": \"NOT_A_REAL_TYPE\"\n}" },
            "url": { "raw": "{{gatewayUrl}}/api/work-orders", "host": ["{{gatewayUrl}}"], "path": ["api", "work-orders"] }
          }
        },
        {
          "name": "List Work Orders (sayfalama + sıralama)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gatewayUrl}}/api/work-orders?page=1&pageSize=25&sort=createdAt:desc",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "work-orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "25" },
                { "key": "sort", "value": "createdAt:desc" }
              ]
            }
          }
        },
        {
          "name": "List Work Orders (filtre: status + type + gisId)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gatewayUrl}}/api/work-orders?status=STARTED&type=PLANNED_OUTAGE_WORK_ORDER&gisId=CB-1024",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "work-orders"],
              "query": [
                { "key": "status", "value": "STARTED" },
                { "key": "type", "value": "PLANNED_OUTAGE_WORK_ORDER" },
                { "key": "gisId", "value": "CB-1024" }
              ]
            }
          }
        },
        {
          "name": "Get Work Order by Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gatewayUrl}}/api/work-orders/{{workOrderId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "work-orders", "{{workOrderId}}"]
            }
          }
        },
        {
          "name": "Patch Work Order — STARTED → ASSIGNED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('workOrderVersion', String(pm.response.json().version));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ASSIGNED\",\n  \"version\": {{workOrderVersion}}\n}" },
            "url": {
              "raw": "{{gatewayUrl}}/api/work-orders/{{workOrderId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "work-orders", "{{workOrderId}}"]
            }
          }
        },
        {
          "name": "Patch Work Order — atlamalı geçiş ASSIGNED → DONE -> 409",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"DONE\",\n  \"version\": {{workOrderVersion}}\n}" },
            "url": {
              "raw": "{{gatewayUrl}}/api/work-orders/{{workOrderId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "work-orders", "{{workOrderId}}"]
            }
          }
        },
        {
          "name": "Create Work Order — yetkisiz (kesinti operatörü token'ıyla) -> 403",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"gisId\": \"CB-0001\",\n  \"type\": \"BASIC_WORK\"\n}" },
            "url": { "raw": "{{gatewayUrl}}/api/work-orders", "host": ["{{gatewayUrl}}"], "path": ["api", "work-orders"] },
            "description": "Önce 'Login — kesinti operatörü' isteğini çalıştır, sonra bunu."
          }
        }
      ]
    },
    {
      "name": "Health & Ready",
      "item": [
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{gatewayUrl}}/health", "host": ["{{gatewayUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "Access Ready (direkt, gateway olmadan)",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{accessDirectUrl}}/ready", "host": ["{{accessDirectUrl}}"], "path": ["ready"] }
          }
        },
        {
          "name": "Outage Ready (direkt, gateway olmadan)",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{outageDirectUrl}}/ready", "host": ["{{outageDirectUrl}}"], "path": ["ready"] }
          }
        },
        {
          "name": "Work Order Ready (direkt, gateway olmadan)",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{workOrderDirectUrl}}/ready", "host": ["{{workOrderDirectUrl}}"], "path": ["ready"] }
          }
        }
      ]
    }
  ]
}
