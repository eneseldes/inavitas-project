{
  "info": {
    "name": "EDAS — Faz 2 (access + outage + work-order)",
    "description": "Faz 0/1/2 için hazır istekler. Gateway (Faz 3) henüz yok; outage-service ve work-order-service'i doğrudan çağırıyoruz ve gateway'in ileride ekleyeceği X-User-* header'larını elle taşıyoruz. Önce 'Auth' klasöründen bir login isteği çalıştır — userId/userEmail/userPermissions collection değişkenlerini otomatik doldurur, sonraki tüm istekler onları kullanır.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "accessBaseUrl", "value": "http://localhost:3001" },
    { "key": "outageBaseUrl", "value": "http://localhost:3002" },
    { "key": "workOrderBaseUrl", "value": "http://localhost:3003" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "userEmail", "value": "" },
    { "key": "userPermissions", "value": "" },
    { "key": "outageId", "value": "" },
    { "key": "outageVersion", "value": "0" },
    { "key": "workOrderId", "value": "" },
    { "key": "workOrderVersion", "value": "0" }
  ],
  "item": [
    {
      "name": "Auth (access-service :3001)",
      "item": [
        {
          "name": "Login — admin (her iki yetki de var)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "pm.collectionVariables.set('userId', body.user.id);",
                  "pm.collectionVariables.set('userEmail', body.user.email);",
                  "pm.collectionVariables.set('userPermissions', body.user.permissions.join(','));",
                  "pm.test('200 döndü', () => pm.response.to.have.status(200));",
                  "pm.test('permissions dolu', () => pm.expect(body.user.permissions.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@edas.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": { "raw": "{{accessBaseUrl}}/auth/login", "host": ["{{accessBaseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login — kesinti operatörü (yalnızca outage:*)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "pm.collectionVariables.set('userId', body.user.id);",
                  "pm.collectionVariables.set('userEmail', body.user.email);",
                  "pm.collectionVariables.set('userPermissions', body.user.permissions.join(','));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kesinti@edas.com\",\n  \"password\": \"Kesinti123!\"\n}"
            },
            "url": { "raw": "{{accessBaseUrl}}/auth/login", "host": ["{{accessBaseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login — saha personeli (yalnızca workorder:*)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "pm.collectionVariables.set('userId', body.user.id);",
                  "pm.collectionVariables.set('userEmail', body.user.email);",
                  "pm.collectionVariables.set('userPermissions', body.user.permissions.join(','));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"isemri@edas.com\",\n  \"password\": \"IsEmri123!\"\n}"
            },
            "url": { "raw": "{{accessBaseUrl}}/auth/login", "host": ["{{accessBaseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Me (JWT'yi kendi doğrular — Authorization header)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{accessBaseUrl}}/auth/me", "host": ["{{accessBaseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{accessBaseUrl}}/auth/refresh", "host": ["{{accessBaseUrl}}"], "path": ["auth", "refresh"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{accessBaseUrl}}/auth/logout", "host": ["{{accessBaseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Outages (outage-service :3002)",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{outageBaseUrl}}/health", "host": ["{{outageBaseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "Ready (DB bağlantısını kontrol eder)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{outageBaseUrl}}/ready", "host": ["{{outageBaseUrl}}"], "path": ["ready"] }
          }
        },
        {
          "name": "Create Outage",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('outageId', body.id);",
                  "  pm.collectionVariables.set('outageVersion', String(body.version));",
                  "}",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "{{userPermissions}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gisId\": \"CB-1024\",\n  \"startedAt\": \"2026-08-06T10:00:00Z\"\n}"
            },
            "url": { "raw": "{{outageBaseUrl}}/outages", "host": ["{{outageBaseUrl}}"], "path": ["outages"] }
          }
        },
        {
          "name": "Create Outage (endedAt verilirse otomatik ENERGIZED — FR-2.6)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "{{userPermissions}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gisId\": \"CB-2048\",\n  \"startedAt\": \"2026-08-06T08:00:00Z\",\n  \"endedAt\": \"2026-08-06T09:30:00Z\"\n}"
            },
            "url": { "raw": "{{outageBaseUrl}}/outages", "host": ["{{outageBaseUrl}}"], "path": ["outages"] }
          }
        },
        {
          "name": "Create Outage — geçersiz (endedAt < startedAt) -> 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "{{userPermissions}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gisId\": \"CB-9999\",\n  \"startedAt\": \"2026-08-06T10:00:00Z\",\n  \"endedAt\": \"2026-08-06T09:00:00Z\"\n}"
            },
            "url": { "raw": "{{outageBaseUrl}}/outages", "host": ["{{outageBaseUrl}}"], "path": ["outages"] }
          }
        },
        {
          "name": "List Outages (sayfalama + sıralama)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "{{userPermissions}}" }
            ],
            "url": {
              "raw": "{{outageBaseUrl}}/outages?page=1&pageSize=25&sort=createdAt:desc",
              "host": ["{{outageBaseUrl}}"],
              "path": ["outages"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "25" },
                { "key": "sort", "value": "createdAt:desc" }
              ]
            }
          }
        },
        {
          "name": "List Outages (filtre: status + gisId + tarih aralığı)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "{{userPermissions}}" }
            ],
            "url": {
              "raw": "{{outageBaseUrl}}/outages?status=STARTED,ENERGIZED&gisId=CB-1024&startedAtFrom=2026-01-01&startedAtTo=2026-12-31",
              "host": ["{{outageBaseUrl}}"],
              "path": ["outages"],
              "query": [
                { "key": "status", "value": "STARTED,ENERGIZED" },
                { "key": "gisId", "value": "CB-1024" },
                { "key": "startedAtFrom", "value": "2026-01-01" },
                { "key": "startedAtTo", "value": "2026-12-31" }
              ]
            }
          }
        },
        {
          "name": "Get Outage by Id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "{{userPermissions}}" }
            ],
            "url": {
              "raw": "{{outageBaseUrl}}/outages/{{outageId}}",
              "host": ["{{outageBaseUrl}}"],
              "path": ["outages", "{{outageId}}"]
            }
          }
        },
        {
          "name": "Patch Outage — STARTED → ENERGIZED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('outageVersion', String(pm.response.json().version));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "{{userPermissions}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ENERGIZED\",\n  \"version\": {{outageVersion}}\n}"
            },
            "url": {
              "raw": "{{outageBaseUrl}}/outages/{{outageId}}",
              "host": ["{{outageBaseUrl}}"],
              "path": ["outages", "{{outageId}}"]
            }
          }
        },
        {
          "name": "Patch Outage — geçersiz geçiş STARTED → ARCHIVED -> 409",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "{{userPermissions}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ARCHIVED\",\n  \"version\": 0\n}" },
            "url": {
              "raw": "{{outageBaseUrl}}/outages/{{outageId}}",
              "host": ["{{outageBaseUrl}}"],
              "path": ["outages", "{{outageId}}"]
            }
          }
        },
        {
          "name": "Patch Outage — bayat version (aynı isteği tekrarla) -> 409 optimistic lock",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "{{userPermissions}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ENERGIZED\",\n  \"version\": 0\n}" },
            "url": {
              "raw": "{{outageBaseUrl}}/outages/{{outageId}}",
              "host": ["{{outageBaseUrl}}"],
              "path": ["outages", "{{outageId}}"]
            }
          }
        },
        {
          "name": "Create Outage — yetkisiz (workorder:* header'larıyla) -> 403",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "workorder:read,workorder:write" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gisId\": \"CB-0001\",\n  \"startedAt\": \"2026-08-06T10:00:00Z\"\n}"
            },
            "url": { "raw": "{{outageBaseUrl}}/outages", "host": ["{{outageBaseUrl}}"], "path": ["outages"] }
          }
        },
        {
          "name": "List Outages — header'sız (gateway yok, kimlik yok) -> 401",
          "request": {
            "method": "GET",
            "url": { "raw": "{{outageBaseUrl}}/outages", "host": ["{{outageBaseUrl}}"], "path": ["outages"] }
          }
        }
      ]
    },
    {
      "name": "Work Orders (work-order-service :3003)",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{workOrderBaseUrl}}/health", "host": ["{{workOrderBaseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "Ready (DB bağlantısını kontrol eder)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{workOrderBaseUrl}}/ready", "host": ["{{workOrderBaseUrl}}"], "path": ["ready"] }
          }
        },
        {
          "name": "Create Work Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('workOrderId', body.id);",
                  "  pm.collectionVariables.set('workOrderVersion', String(body.version));",
                  "}",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "{{userPermissions}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gisId\": \"CB-1024\",\n  \"type\": \"PLANNED_OUTAGE_WORK_ORDER\"\n}"
            },
            "url": { "raw": "{{workOrderBaseUrl}}/work-orders", "host": ["{{workOrderBaseUrl}}"], "path": ["work-orders"] }
          }
        },
        {
          "name": "Create Work Order — geçersiz type -> 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "{{userPermissions}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gisId\": \"CB-1024\",\n  \"type\": \"NOT_A_REAL_TYPE\"\n}"
            },
            "url": { "raw": "{{workOrderBaseUrl}}/work-orders", "host": ["{{workOrderBaseUrl}}"], "path": ["work-orders"] }
          }
        },
        {
          "name": "List Work Orders (sayfalama + sıralama)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "{{userPermissions}}" }
            ],
            "url": {
              "raw": "{{workOrderBaseUrl}}/work-orders?page=1&pageSize=25&sort=createdAt:desc",
              "host": ["{{workOrderBaseUrl}}"],
              "path": ["work-orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "25" },
                { "key": "sort", "value": "createdAt:desc" }
              ]
            }
          }
        },
        {
          "name": "List Work Orders (filtre: status + type + gisId)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "{{userPermissions}}" }
            ],
            "url": {
              "raw": "{{workOrderBaseUrl}}/work-orders?status=STARTED&type=PLANNED_OUTAGE_WORK_ORDER&gisId=CB-1024",
              "host": ["{{workOrderBaseUrl}}"],
              "path": ["work-orders"],
              "query": [
                { "key": "status", "value": "STARTED" },
                { "key": "type", "value": "PLANNED_OUTAGE_WORK_ORDER" },
                { "key": "gisId", "value": "CB-1024" }
              ]
            }
          }
        },
        {
          "name": "Get Work Order by Id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "{{userPermissions}}" }
            ],
            "url": {
              "raw": "{{workOrderBaseUrl}}/work-orders/{{workOrderId}}",
              "host": ["{{workOrderBaseUrl}}"],
              "path": ["work-orders", "{{workOrderId}}"]
            }
          }
        },
        {
          "name": "Patch Work Order — STARTED → ASSIGNED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('workOrderVersion', String(pm.response.json().version));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "{{userPermissions}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ASSIGNED\",\n  \"version\": {{workOrderVersion}}\n}"
            },
            "url": {
              "raw": "{{workOrderBaseUrl}}/work-orders/{{workOrderId}}",
              "host": ["{{workOrderBaseUrl}}"],
              "path": ["work-orders", "{{workOrderId}}"]
            }
          }
        },
        {
          "name": "Patch Work Order — atlamalı geçiş ASSIGNED → DONE -> 409",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "{{userPermissions}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"DONE\",\n  \"version\": {{workOrderVersion}}\n}" },
            "url": {
              "raw": "{{workOrderBaseUrl}}/work-orders/{{workOrderId}}",
              "host": ["{{workOrderBaseUrl}}"],
              "path": ["work-orders", "{{workOrderId}}"]
            }
          }
        },
        {
          "name": "Create Work Order — yetkisiz (outage:* header'larıyla) -> 403",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Email", "value": "{{userEmail}}" },
              { "key": "X-User-Permissions", "value": "outage:read,outage:write" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gisId\": \"CB-0001\",\n  \"type\": \"BASIC_WORK\"\n}"
            },
            "url": { "raw": "{{workOrderBaseUrl}}/work-orders", "host": ["{{workOrderBaseUrl}}"], "path": ["work-orders"] }
          }
        }
      ]
    }
  ]
}
